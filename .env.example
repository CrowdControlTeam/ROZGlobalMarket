# Plantilla de variables de entorno para desarrollo local. En local se usan
# DOS archivos (ninguno se sube al repo, ver .gitignore):
#
#   - .env        → SOLO DATABASE_URL. La leen drizzle-kit (`npm run db:migrate`,
#                   `db:studio`) y los scripts de seed (tsx), que NO leen .env.local.
#   - .env.local  → el resto (Discord, AUTH_SECRET, APP_URL, Gemini).
#
# Next.js fusiona .env + .env.local, así que la app ve todas las variables.
# Copia las secciones de abajo al archivo que corresponde y rellena los valores.

# Discord Developer Portal > tu aplicación > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ID del servidor de Discord de la guild (clic derecho sobre el servidor
# con el modo desarrollador activado > Copiar ID de servidor)
DISCORD_GUILD_ID=

# La URL del webhook de Discord ya NO es una variable de entorno: se
# configura desde /admin (tabla MarketConfig), editable sin redesplegar.

# Opcional. Token de un bot de Discord (Developer Portal > tu aplicación >
# Bot > Reset Token), invitado al servidor de la guild. Solo se usa para que
# /admin pueda listar los roles del servidor por nombre al elegir quién más
# (aparte de quien tenga el permiso Administrator) accede al panel — sin
# esto, se introducen los IDs de rol a mano. Nunca se guarda en base de
# datos. El mismo bot servirá en el futuro para las DMs de transacción.
DISCORD_BOT_TOKEN=

# Opcional. IDs de usuario de Discord con acceso al panel /admin, separados
# por comas (p.ej. "123456789,987654321"). Se SUMAN al permiso Administrator
# nativo y a los roles configurados en /admin — pensado para darte acceso si
# el mercado corre en un servidor que no administras. Clic derecho sobre el
# usuario (modo desarrollador activado) > Copiar ID de usuario.
DISCORD_ADMIN_IDS=

# Secreto para firmar la sesión de NextAuth. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# === Va en .env (no en .env.local) ===
# Cadena de conexión a Postgres. La usa la app (driver serverless de Neon en el
# Worker; node-postgres en local) y también drizzle-kit y los scripts de seed —
# ver src/db/index.ts.
#
# Desarrollo local (docker-compose up -d db): Postgres local.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/roz_global_market
#
# Producción (Neon): endpoint pooled de Neon (host con "-pooler") para la app.
# Para las migraciones (drizzle-kit) usa el endpoint DIRECTO (sin "-pooler").
# Se copia del dashboard de Neon a las variables de entorno del despliegue.
DATABASE_URL=

# URL pública de la app, para construir enlaces absolutos (webhooks de Discord, etc.).
# Local: http://localhost:3000 — en producción, el dominio de Cloudflare.
APP_URL=http://localhost:3000

# API key de Gemini (https://aistudio.google.com/apikey), para el reconocimiento
# de item a partir de una captura del tooltip en el formulario de venta.
GEMINI_API_KEY=
