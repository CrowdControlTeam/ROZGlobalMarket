generator client {
  provider = "prisma-client-js"
  // driverAdapters: permite pasar un driver adapter a PrismaClient para la
  // conexión (Neon serverless en Workers, pg en local) — ver src/lib/prisma.ts.
  // El que en Workers se use el motor WASM (y no el binario nativo, que haría
  // fs.readdir -> 500) lo consigue OpenNext parcheando el cliente: para ello
  // Prisma va como serverExternalPackage en next.config.ts.
  previewFeatures = ["driverAdapters"]
}

// DATABASE_URL (pooled) y DIRECT_URL (directa, para `prisma migrate`) se
// leen del entorno — ver src/lib/prisma.ts y .env.example. En producción
// apuntan a Neon; en local, al Postgres de docker-compose.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemCategory {
  WEAPON
  ARMOR
  CARD
  CONSUMABLE
  COSTUME
  PET
  ENCHANT
  ETC
}

// Slot que ocupa una armadura, o slot compatible de una carta.
enum EquipSlot {
  UPPER_HEADGEAR
  MID_HEADGEAR
  LOWER_HEADGEAR
  ARMOR
  SHIELD
  GARMENT
  FOOTGEAR
  ACCESSORY
  WEAPON
}

enum ListingStatus {
  ACTIVE
  // Cerrado con éxito (hubo ≥1 Deal ACCEPTED). Genérico para todos los tipos —
  // la etiqueta visible cambia por tipo (ver listingStatusLabel).
  COMPLETED
  CANCELLED
  EXPIRED
}

// SALE = venta directa (con precio). TRADE = se publica el item para
// intercambiarlo por otro, sin precio — en el detalle, quien no es el
// vendedor ve "Ofrecer items" en vez de "Comprar" (ver TradeOffer). BUY =
// petición de compra ("busco X, pago Y por unidad") — mismo ciclo de vida que
// SALE/TRADE (se publica, queda abierto, algo externo lo cierra después),
// solo que quien publica busca comprar en vez de vender. En BUY, `price`
// es el precio fijo que paga por unidad (no un máximo a negociar: si se
// quiere negociar, se hace fuera de la app) en vez de precio de venta, y
// `posterId` es quien compra, no quien vende — mismos campos, doble
// sentido según `type`. Sin oferta/aceptación dentro de la app: quien
// publica cierra la petición a mano (norma 2.4 del plan original, deliberadamente
// simple v1).
enum ListingType {
  SALE
  TRADE
  BUY
  // Regalo. Con destinatario = envío directo instantáneo (Deal ACCEPTED al
  // crear). Sin destinatario = reclamable por cualquiera (reserva→confirmación,
  // como una venta pero gratis). Funde la antigua tabla Gift. price siempre
  // null. Ver el rediseño de listings.
  GIFT
}

// Solo relevante cuando category = WEAPON. Taxonomía estándar de tipos de
// arma de RO — determina, vía MagicalWeaponType, de qué pool de random
// options (ItemOptionDef) puede salir el arma. Poblado por el generator desde
// el campo `slot` de la fuente.
enum WeaponType {
  DAGGER
  ONE_HAND_SWORD
  TWO_HAND_SWORD
  ONE_HAND_SPEAR
  TWO_HAND_SPEAR
  ONE_HAND_AXE
  TWO_HAND_AXE
  MACE
  ROD
  TWO_HAND_ROD
  BOW
  KNUCKLE
  INSTRUMENT
  WHIP
  BOOK
  KATAR
  REVOLVER
  RIFLE
  GATLING_GUN
  SHOTGUN
  GRENADE_LAUNCHER
  FUUMA_SHURIKEN
}

// Grupo de equipo para el pool de random options — no todos los EquipSlot
// tienen options (headgears/shield/accessory/card no), y las armas se
// dividen en dos pools distintos según WeaponAttackType, de ahí que sea un
// enum aparte en vez de reutilizar EquipSlot/ItemCategory directamente.
enum ItemOptionGroup {
  ARMOR
  GARMENT
  FOOTGEAR
  WEAPON_PHYSICAL
  WEAPON_MAGICAL
}

model User {
  // Igual al id de Discord (snowflake): no hay otro proveedor de login.
  id         String   @id
  username   String
  avatarUrl  String?
  guildRoles String[] @default([])
  createdAt  DateTime @default(now())

  listings Listing[]
  // Tratos donde este usuario es la contraparte (comprador/vendedor/oferente/
  // reclamante) — ver model Deal.
  deals    Deal[]
}

model Item {
  // ID estable del catálogo (el id de item de RO, p.ej. "501") — no un cuid
  // generado: así el mismo id sirve en catálogo, BD, bundle de búsqueda y en
  // Listing/TradeOffer/Gift.itemId, y el import puede hacer upsert idempotente
  // por id. La app nunca crea Items (solo el import), así que no necesita default.
  id          String       @id
  name        String
  description String?
  category    ItemCategory
  // Slot de equipo (armaduras) o slot en el que se puede montar (cartas).
  slot        EquipSlot?
  // Solo relevante para category = WEAPON — ver comentario del enum.
  // Nullable: armas aún sin clasificar (o sin tipo, p.ej. munición) no
  // muestran random options todavía.
  weaponType WeaponType?
  // Copia propia del icono (sin hotlink a la fuente externa).
  iconUrl     String
  // Ficha de origen de la carga de datos, para trazabilidad.
  sourceUrl   String?
  // false si el generador no pudo verificar el item (nombre duplicado o fallo
  // de red al consultar la fuente) — se importa igual, es solo una marca de
  // calidad del dato para repasarlo luego. Ver prisma/importCatalog.mjs.
  verified    Boolean      @default(true)
  importedAt  DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  listings       Listing[]
  // Deals en los que este item es la contraoferta de un trade (Deal.offeredItem).
  offeredInDeals Deal[]

  @@index([category, slot])
  @@index([name])
}

// Fase 1 del plan original: solo venta directa. La Fase 3 añade el tipo TRADE (ver ListingType).
// El refactor "listings" fusiona BuyRequest aquí como type=BUY. Los campos
// de subasta se añaden en la Fase 2 (aparcada por ahora).
model Listing {
  id           String        @id @default(cuid())
  // Quien publica — vendedor en SALE/TRADE, comprador en BUY (ver
  // ListingType). Nombre neutro a propósito: "seller" no encajaría con BUY.
  poster       User          @relation(fields: [posterId], references: [id])
  posterId     String
  item         Item          @relation(fields: [itemId], references: [id])
  itemId       String
  type         ListingType   @default(SALE)
  // null = ILIMITADO ("los que tengas") — solo en SALE/BUY de materiales; nunca
  // se cierra solo por recuento, lo cierra el poster a mano. TRADE/GIFT siempre
  // tienen tope. Lo vendido/entregado/cumplido se calcula de los Deal ACCEPTED,
  // no hay contador denormalizado — ver deals.ts / computeListingQuantities.
  quantity     Int?
  // price: null cuando type = TRADE o GIFT (no tienen precio). En BUY es el
  // precio fijo por unidad que paga (no un máximo a negociar) en vez de precio
  // de venta — mismo campo, doble sentido según `type`.
  // price: null cuando type = TRADE o GIFT (no tienen precio). En BUY es el
  // precio fijo por unidad que paga (no un máximo a negociar) en vez de precio
  // de venta — mismo campo, doble sentido según `type`.
  price        Int?
  status       ListingStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Nivel de refine (+0 a MarketConfig.maxRefineLevel) — solo relevante para
  // equipo refinable (arma, o armadura en slot casco superior/cuerpo/
  // escudo/prenda/calzado; accesorios y cascos medio/inferior no). 0 en
  // cualquier otro item, y no se muestra como prefijo "+N" hasta 1.
  refineLevel Int @default(0)

  // Número de slots de carta del ejemplar concreto (no del catálogo: dos
  // unidades del mismo item pueden tener distinto número) — arma hasta 4,
  // armadura hasta 1 salvo casco inferior (0). Ver
  // src/lib/card-slots-constants.ts. Se muestra como sufijo "[N]" pegado al
  // nombre, nunca en 0.
  cardSlots Int @default(0)

  // Notas libres opcionales que escribe quien publica (cualquier tipo): detalles
  // del trato, horario de conexión, condiciones, etc. Se muestran en el detalle.
  // Longitud acotada en las acciones (ver MAX_LISTING_NOTES_LENGTH).
  notes String?

  options ListingOption[]
  deals   Deal[]

  @@index([status, createdAt])
  @@index([price])
}

enum DealStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// Trato/oferta/reserva de una contraparte contra un Listing. Unifica y
// sustituirá a Purchase (compra) y TradeOffer (oferta de trade) — ver el plan
// del rediseño de listings. Una fila = "userId quiere/cerró `quantity` de este
// listing". Ciclo: PENDING (reserva u oferta en curso) -> ACCEPTED (cerrado) /
// REJECTED / CANCELLED. Las filas ACCEPTED son además la trazabilidad de con
// quién se resolvió (evita un `takerId` en Listing, que no valdría para ventas
// multi-comprador). AÚN NO se usa en runtime: se cablea en fases posteriores.
model Deal {
  id        String     @id @default(cuid())
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  // La contraparte: comprador (SALE), vendedor (BUY), oferente (TRADE),
  // reclamante (GIFT). Nombre neutro a propósito.
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  quantity  Int
  status    DealStatus @default(PENDING)
  // Precio unitario acordado: precio fijo = precio del listing; sin-precio =
  // precio ofertado; TRADE/GIFT = null.
  unitPrice Int?

  // Contraoferta, solo en TRADE (el item que se ofrece a cambio). Sin random
  // options en la oferta, igual que el antiguo TradeOffer. offeredQuantity es
  // la cantidad de ESE item (distinta de `quantity`, que son unidades del
  // listing — en un trade siempre 1).
  offeredItem      Item?   @relation(fields: [offeredItemId], references: [id])
  offeredItemId    String?
  offeredQuantity  Int?
  offeredRefine    Int?
  offeredCardSlots Int?
  zenyOffered      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, status])
  @@index([userId])
}

// Configuración global del mercado, editable en base de datos (Prisma
// Studio) sin desplegar código. Fila única (id fijo = 1) — ver
// prisma/seedMarketConfig.mjs.
model MarketConfig {
  id Int @id @default(1)
  // Refine real de RO Zero sin confirmar todavía (0-15 según el usuario,
  // pero sin verificar) — 10 de arranque, se ajusta aquí cuando se sepa.
  maxRefineLevel Int @default(10)

  // Notificación de nueva venta al canal de Discord: solo se envía si hay
  // URL Y el toggle está activo — si falta cualquiera de los dos, no se
  // manda nada (ver src/lib/discord-webhook.ts). Editable desde /admin.
  webhookUrl     String?
  webhookEnabled Boolean @default(false)

  // El reconocimiento de item por captura necesita esto Y la variable de
  // entorno GEMINI_API_KEY seteada — la key en sí nunca se guarda en base
  // de datos, solo el toggle (ver src/lib/item-recognition.ts). Si falta
  // cualquiera de los dos, el bloque ni se renderiza en el formulario.
  imageRecognitionEnabled Boolean @default(false)
  // Qué modelo de Gemini usar para el reconocimiento — editable sin
  // redesplegar (solo es un string en la URL de la llamada). Valores
  // soportados por el desplegable de /admin: "gemini-flash-latest"
  // (detecta bien los iconos de slot) y "gemini-flash-lite-latest" (más
  // barato/rápido, pero puede fallar contando slots).
  geminiModel String @default("gemini-flash-latest")

  // DMs de transacción (norma 2.10 del plan original) necesitan esto Y la variable de entorno
  // DISCORD_BOT_TOKEN seteada — el token en sí nunca se guarda en base de
  // datos, solo el toggle (ver sendDirectMessage en src/lib/discord-bot.ts).
  // Activo por defecto: no hay nada que "deshacer" al desactivarlo, solo
  // deja de intentarlo.
  dmNotificationsEnabled Boolean @default(true)

  // Random options necesita esto Y que el catálogo (ItemOptionDef) tenga
  // filas — pensado para cuando el mercado sirva a versiones de RO además
  // de RO Zero que todavía no tengan su catálogo de options importado (ver
  // src/lib/item-options.ts). Activo por defecto porque el catálogo actual
  // ya está cargado.
  optionsEnabled Boolean @default(true)

  // Bloquea crear ventas y comprar para todo el mundo salvo administradores
  // (ver src/lib/admin-guard.ts). Pensado para desplegar cambios grandes
  // sin que se publique/compre a medio camino.
  maintenanceModeEnabled Boolean @default(false)

  // Roles de Discord con acceso a /admin, SUMADOS al permiso Administrator
  // nativo (no lo sustituyen) — ver isGuildAdmin en src/auth.ts. IDs en
  // crudo: el panel los muestra con nombre real si hay bot configurado
  // (DISCORD_BOT_TOKEN, nunca en base de datos), o como entrada manual si no.
  adminRoleIds String[] @default([])

  // Rol de Discord requerido para ACCEDER a la app (distinto del panel). Si
  // está puesto, en el login no basta con pertenecer al guild: hay que tener
  // además este rol. Los admins están exentos (para no auto-bloquearse). Null
  // = sin restricción, acceso solo por pertenencia como hasta ahora. Ver
  // el callback signIn de src/auth.ts.
  accessRoleId String?

  // Nombre de la app mostrado en la cabecera (enlaza a /market) y como
  // <title> de la pestaña — cada guild pone el suyo. Null hasta
  // configurarse la primera vez: el placeholder/fallback "ROZ Global
  // Market" vive en código (DEFAULT_SITE_NAME en src/lib/market-config.ts),
  // no aquí, para no confundir "sin configurar" con "configurado
  // literalmente a ROZ Global Market".
  siteName String?

  // Imágenes de marca subidas desde /admin, guardadas como data-URI base64
  // (no hay object storage; ver AdminConfigForm / branding-constants.ts).
  // logoUrl se muestra junto al título en la cabecera (solo PC); homeImageUrl
  // en el hub de inicio, entre el saludo y "¿A dónde vamos?". Null = sin
  // configurar (no se muestran).
  logoUrl      String?
  homeImageUrl String?
}

// Qué WeaponType cuentan como "arma mágica" (pool WEAPON_MAGICAL) en vez de
// "arma física" (WEAPON_PHYSICAL) — la presencia de una fila es la señal (no
// hace falta columna booleana). Editable directamente en la base de datos
// (Prisma Studio) sin necesidad de desplegar código. Seed por defecto: ROD,
// TWO_HAND_ROD, BOOK — ver prisma/seedMagicalWeaponType.mjs.
model MagicalWeaponType {
  type WeaponType @id
}

// Catálogo de estadísticas de random option posibles, por grupo de equipo y
// por slot posicional (1, 2, 3 — cada posición tiene su propio pool, no son
// intercambiables entre sí). Poblado desde datos reales, ver
// prisma/seedItemOptions.mjs.
model ItemOptionDef {
  id        String          @id @default(cuid())
  group     ItemOptionGroup
  slotIndex Int
  // Identificador estable derivado del label (p.ej. "MAX_HP_PCT"), para no
  // depender del texto exacto del label como clave.
  statCode  String
  label     String
  minValue  Int
  // Igual a minValue cuando el valor es fijo (p.ej. ASPD siempre +1).
  maxValue  Int

  selections ListingOption[]

  @@unique([group, slotIndex, statCode])
  @@index([group, slotIndex])
}

// Random option concreta de un listing — hasta MAX_OPTION_SLOTS (ver
// src/lib/item-options.ts) por listing, siempre ocupando las posiciones
// desde 1 en adelante sin huecos. En SALE/TRADE, `value` es el roll exacto
// que le salió a esa instancia real. En BUY no hay instancia (se publica
// antes de tener el item) — ahí `value` es el mínimo que el comprador pide
// para esa stat, mismo patrón de doble sentido que `Listing.price` según
// `type`. Validado siempre contra [def.minValue, def.maxValue] en los dos
// casos (no tiene sentido pedir, ni tener, algo fuera del rango real).
model ListingOption {
  id        String        @id @default(cuid())
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  slotIndex Int
  def       ItemOptionDef @relation(fields: [defId], references: [id])
  defId     String
  value     Int

  @@unique([listingId, slotIndex])
}

// Contador de rate-limit por ventana fija, respaldado en BD para que
// funcione entre instancias (serverless/Cloudflare Workers), a diferencia de
// un contador en memoria que se reinicia por instancia. `key` identifica el
// límite (p.ej. "recognize:<discordId>"), `count` las peticiones en la
// ventana actual y `windowStart` cuándo empezó — ver src/lib/rate-limit.ts.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
